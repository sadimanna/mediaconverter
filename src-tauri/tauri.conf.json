{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFmpeg Studio",
  "version": "1.1.0",
  "identifier": "com.example.ffmpegstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FFmpeg Studio",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
